#include <windows.h>
#include "version.h"
#include "launcher/resources/resources.h"
IDI_WITNESS_VR ICON "launcher.ico"
1 RT_MANIFEST "launcher.manifest"
1 VERSIONINFO
FILEVERSION WITNESS_VERSION_TUPLE
PRODUCTVERSION WITNESS_VERSION_TUPLE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "The Witness VR portable launcher\0"
   VALUE "ProductName", "The Witness VR\0"
   VALUE "FileVersion", WITNESS_VERSION_STRING "\0"
   VALUE "ProductVersion", WITNESS_VERSION_STRING "\0"
   VALUE "OriginalFilename", "WitnessVR.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
